{
  "name": "aymusic-player",
  "version": "1.0.0",
  "homepage": "https://example.com",
  "description": "AYMusic Player - minimalist audio player for Linux",
  "license": "ISC",
  "author": "Yashar <yashar@example.com>",
  "type": "commonjs",
  "main": "main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron . --no-sandbox --disable-gpu",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npm run dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "build": {
    "appId": "com.example.aymusicplayer",
    "productName": "AYMusic Player",
    "icon": "build/icons/512x512.png",
    "files": [
      "dist/**",
      "main/**",
      "package.json",
      "node_modules/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
