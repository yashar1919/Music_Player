{
  "name": "aymusic-player",
  "version": "1.0.0",
  "homepage": "https://github.com/yashar1919/Music_Player",
  "description": "AYMusic Player - A beautiful and minimalist audio player designed for Linux",
  "license": "MIT",
  "author": "Yashar <yashar@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashar1919/Music_Player.git"
  },
  "bugs": {
    "url": "https://github.com/yashar1919/Music_Player/issues"
  },
  "keywords": [
    "music",
    "player",
    "audio",
    "linux",
    "electron",
    "mp3",
    "flac",
    "music-player",
    "audio-player",
    "desktop-app"
  ],
  "type": "commonjs",
  "main": "main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "electron . --no-sandbox --disable-gpu",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npm run dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:windows": "npm run build:renderer && electron-builder --windows",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:windows": "electron-builder --windows nsis",
    "dist:all": "npm run build:renderer && electron-builder --linux --windows",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "build": {
    "appId": "com.aymusic.player",
    "productName": "AYMusic Player",
    "icon": "build/icons/icon.png",
    "files": [
      "dist/**",
      "main/**",
      "package.json",
      "node_modules/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "wav",
            "ogg",
            "flac",
            "m4a",
            "aac",
            "wma"
          ],
          "name": "Audio File",
          "description": "Audio file",
          "icon": "build/icons/icon.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AYMusic Player",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "license": "LICENSE",
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "maintainer": "Yashar <yashar@example.com>",
      "vendor": "AYMusic",
      "synopsis": "Minimalist audio player for Linux",
      "description": "AYMusic Player - A beautiful and minimalist audio player designed for Linux",
      "mimeTypes": [
        "audio/mpeg",
        "audio/x-mpeg",
        "audio/mp3",
        "audio/x-mp3",
        "audio/mpeg3",
        "audio/x-mpeg3",
        "audio/mpg",
        "audio/x-mpg",
        "audio/x-mpegaudio",
        "audio/wav",
        "audio/x-wav",
        "audio/ogg",
        "audio/x-ogg",
        "application/ogg",
        "audio/flac",
        "audio/x-flac",
        "audio/mp4",
        "audio/x-m4a",
        "audio/aac",
        "audio/x-aac",
        "audio/wma",
        "audio/x-ms-wma"
      ],
      "desktop": {
        "entry": {
          "Name": "AYMusic Player",
          "Comment": "Minimalist audio player for Linux",
          "MimeType": "audio/mpeg;audio/x-mpeg;audio/mp3;audio/x-mp3;audio/mpeg3;audio/x-mpeg3;audio/mpg;audio/x-mpg;audio/x-mpegaudio;audio/wav;audio/x-wav;audio/ogg;audio/x-ogg;application/ogg;audio/flac;audio/x-flac;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/wma;audio/x-ms-wma;",
          "Categories": "AudioVideo;Audio;Player;",
          "Keywords": "Music;Audio;Player;Sound;Media;",
          "StartupWMClass": "AYMusic Player"
        }
      }
    }
  }
}
